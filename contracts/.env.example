# Deployer Private Key (64 hex characters without 0x prefix, or with 0x)
PRIVATE_KEY=your_private_key_here

# Base Sepolia RPC URL (e.g. from Alchemy, Infura, or public Base Sepolia RPC)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Basescan API Key for automated contract verification
BASESCAN_API_KEY=your_basescan_api_key_here
